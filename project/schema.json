{
  "title": "OWASP dep-scan roadmap",
  "owner": "owasp-dep-scan",
  "public": true,
  "shortDescription": "Roadmap and work tracking for the OWASP dep-scan organization. See https://github.com/cdxgen/.github/tree/main/project",
  "repositories": [
    "owasp-dep-scan/dep-scan",
    "owasp-dep-scan/blint",
    "owasp-dep-scan/dosai"
  ],
  "fields": [
    {
      "name": "Status",
      "builtin": true,
      "options": [
        {
          "name": "Triage",
          "color": "GRAY",
          "description": "New, not yet looked at by a maintainer"
        },
        {
          "name": "Backlog",
          "color": "PURPLE",
          "description": "Accepted, not scheduled"
        },
        {
          "name": "Ready",
          "color": "BLUE",
          "description": "Scoped well enough for a person or an agent to start"
        },
        {
          "name": "In progress",
          "color": "YELLOW",
          "description": "Someone is working on it, or a draft pull request is open"
        },
        {
          "name": "In review",
          "color": "ORANGE",
          "description": "A pull request is open and ready for review"
        },
        {
          "name": "Blocked",
          "color": "RED",
          "description": "Waiting on something outside the work itself"
        },
        {
          "name": "Done",
          "color": "GREEN",
          "description": "Merged, or closed"
        }
      ]
    },
    {
      "name": "Horizon",
      "options": [
        {
          "name": "Now",
          "color": "GREEN",
          "description": "Being worked on this release cycle"
        },
        {
          "name": "Next",
          "color": "BLUE",
          "description": "Planned for the following cycle"
        },
        {
          "name": "Later",
          "color": "GRAY",
          "description": "Wanted, with no schedule"
        }
      ]
    },
    {
      "name": "Priority",
      "options": [
        {
          "name": "P0",
          "color": "RED",
          "description": "Broken output or a security problem for many users"
        },
        {
          "name": "P1",
          "color": "ORANGE",
          "description": "Important for the next release"
        },
        {
          "name": "P2",
          "color": "GRAY",
          "description": "Worth doing when time allows"
        }
      ]
    },
    {
      "name": "Area",
      "options": [
        {
          "name": "Scanner",
          "color": "BLUE"
        },
        {
          "name": "Server",
          "color": "PURPLE"
        },
        {
          "name": "CSAF",
          "color": "GREEN"
        },
        {
          "name": "Standalone binary",
          "color": "YELLOW"
        },
        {
          "name": "Data quality",
          "color": "ORANGE"
        },
        {
          "name": "Research",
          "color": "PINK"
        },
        {
          "name": "Rust",
          "color": "ORANGE"
        },
        {
          "name": "Go",
          "color": "BLUE"
        },
        {
          "name": ".NET",
          "color": "PURPLE"
        },
        {
          "name": "Android and iOS",
          "color": "GREEN"
        },
        {
          "name": "Windows",
          "color": "BLUE"
        },
        {
          "name": "Binary formats",
          "color": "GRAY"
        },
        {
          "name": "Security",
          "color": "RED"
        },
        {
          "name": "Documentation",
          "color": "GRAY"
        }
      ]
    }
  ],
  "labelFields": [
    {
      "field": "Area",
      "map": {
        "server": "Server",
        "csaf": "CSAF",
        "sea": "Standalone binary",
        "data-quality": "Data quality",
        "false-positive": "Data quality",
        "false-negative": "Data quality",
        "research": "Research",
        "rust": "Rust",
        "go": "Go",
        "dotnet": ".NET",
        "android": "Android and iOS",
        "ipa": "Android and iOS",
        "windows": "Windows",
        "byovd": "Windows",
        "ELF": "Binary formats",
        "PE": "Binary formats",
        "wasm": "Binary formats",
        "security": "Security",
        "documentation": "Documentation"
      }
    }
  ],
  "labels": [
    {
      "name": "blocked",
      "color": "B60205",
      "description": "Waiting on something outside the work itself"
    },
    {
      "name": "needs-decision",
      "color": "FBCA04",
      "description": "A maintainer has to choose before work can continue"
    },
    {
      "name": "needs agent",
      "color": "5319E7",
      "description": "Chosen for the agent workflow: a plan, an implementation and a review"
    }
  ],
  "views": [
    {
      "name": "Status",
      "layout": "BOARD_LAYOUT",
      "filter": "-status:Done",
      "note": "Columns by Status."
    },
    {
      "name": "Horizon",
      "layout": "BOARD_LAYOUT",
      "filter": "-status:Done",
      "note": "Set the column field to Horizon."
    },
    {
      "name": "Triage",
      "layout": "TABLE_LAYOUT",
      "filter": "status:Triage",
      "note": "",
      "columns": [
        "Title",
        "Labels",
        "Area",
        "Repository"
      ]
    },
    {
      "name": "Releases",
      "layout": "TABLE_LAYOUT",
      "filter": "-status:Done",
      "note": "Group by Milestone.",
      "columns": [
        "Title",
        "Status",
        "Priority",
        "Area",
        "Milestone",
        "Linked pull requests"
      ]
    },
    {
      "name": "Agent queue",
      "layout": "TABLE_LAYOUT",
      "filter": "label:\"needs agent\" -status:Done",
      "note": "Group by Status and sort by Priority.",
      "columns": [
        "Title",
        "Status",
        "Priority",
        "Milestone",
        "Area",
        "Linked pull requests"
      ]
    },
    {
      "name": "Needs a person",
      "layout": "TABLE_LAYOUT",
      "filter": "-status:Done label:blocked,needs-decision",
      "note": "",
      "columns": [
        "Title",
        "Status",
        "Labels",
        "Assignees",
        "Priority"
      ]
    }
  ]
}
